<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LogicSimulator.Infrastructure.Converters"
    xmlns:gates="clr-namespace:LogicSimulator.ViewModels.ObjectViewModels.Gates"
    xmlns:selectors="clr-namespace:LogicSimulator.Infrastructure.Selectors"
    xmlns:views="clr-namespace:LogicSimulator.Scene.Views;assembly=LogicSimulator.Scene"
    xmlns:vm="clr-namespace:LogicSimulator.ViewModels.ObjectViewModels">

    <converters:RotationToFloatConverter x:Key="RotationToFloatConverter" />

    <selectors:PortViewTemplateSelector x:Key="PortViewTemplateSelector">
        <selectors:PortViewTemplateSelector.PortDataTemplate>
            <DataTemplate DataType="{x:Type gates:PortViewModel}">
                <views:PortView
                    IsSelected="{Binding Path=IsSelected}"
                    Label="{Binding Path=Name}"
                    Length="{Binding Path=Length}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    State="{Binding Path=State}"
                    StrokeColor="{Binding Path=Parent.StrokeColor}"
                    StrokeThickness="{Binding Path=Parent.StrokeThickness}"
                    StrokeThicknessType="{Binding Path=Parent.StrokeThicknessType}" />
            </DataTemplate>
        </selectors:PortViewTemplateSelector.PortDataTemplate>
    </selectors:PortViewTemplateSelector>

    <selectors:SceneObjectTemplateSelector x:Key="SceneObjectTemplateSelector">
        <selectors:SceneObjectTemplateSelector.UnknownObjectDataTemplate>
            <DataTemplate xmlns:baseVm="clr-namespace:LogicSimulator.ViewModels.ObjectViewModels.Base" DataType="{x:Type baseVm:BaseObjectViewModel}">
                <views:UnknownObjectView Location="{Binding Path=Location}" Rotation="{Binding Path=Rotation, Converter={StaticResource RotationToFloatConverter}}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.UnknownObjectDataTemplate>
        <selectors:SceneObjectTemplateSelector.RectangleDataTemplate>
            <DataTemplate DataType="{x:Type vm:RectangleViewModel}">
                <views:RectangleView
                    Width="{Binding Path=Width}"
                    Height="{Binding Path=Height}"
                    FillColor="{Binding Path=FillColor}"
                    IsFilled="{Binding Path=IsFilled}"
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.RectangleDataTemplate>
        <selectors:SceneObjectTemplateSelector.RoundedRectangleDataTemplate>
            <DataTemplate DataType="{x:Type vm:RoundedRectangleViewModel}">
                <views:RoundedRectangleView
                    Width="{Binding Path=Width}"
                    Height="{Binding Path=Height}"
                    FillColor="{Binding Path=FillColor}"
                    IsFilled="{Binding Path=IsFilled}"
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    RadiusX="{Binding Path=RadiusX}"
                    RadiusY="{Binding Path=RadiusY}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.RoundedRectangleDataTemplate>
        <selectors:SceneObjectTemplateSelector.EllipseDataTemplate>
            <DataTemplate DataType="{x:Type vm:EllipseViewModel}">
                <views:EllipseView
                    FillColor="{Binding Path=FillColor}"
                    IsFilled="{Binding Path=IsFilled}"
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    RadiusX="{Binding Path=RadiusX}"
                    RadiusY="{Binding Path=RadiusY}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.EllipseDataTemplate>
        <selectors:SceneObjectTemplateSelector.BezierCurveDataTemplate>
            <DataTemplate DataType="{x:Type vm:BezierCurveViewModel}">
                <views:BezierCurveView
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Point1="{Binding Path=Point1}"
                    Point2="{Binding Path=Point2}"
                    Point3="{Binding Path=Point3}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.BezierCurveDataTemplate>
        <selectors:SceneObjectTemplateSelector.ArcDataTemplate>
            <DataTemplate DataType="{x:Type vm:ArcViewModel}">
                <views:ArcView
                    EndAngle="{Binding Path=EndAngle}"
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    RadiusX="{Binding Path=RadiusX}"
                    RadiusY="{Binding Path=RadiusY}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StartAngle="{Binding Path=StartAngle}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.ArcDataTemplate>
        <selectors:SceneObjectTemplateSelector.TextBlockDataTemplate>
            <DataTemplate DataType="{x:Type vm:TextBlockViewModel}">
                <views:TextView
                    FontName="{Binding Path=FontName}"
                    FontSize="{Binding Path=FontSize}"
                    IsBold="{Binding Path=IsBold}"
                    IsCross="{Binding Path=IsCross}"
                    IsItalic="{Binding Path=IsItalic}"
                    IsSelected="{Binding Path=IsSelected}"
                    IsUnderlined="{Binding Path=IsUnderlined}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    Text="{Binding Path=Text}"
                    TextColor="{Binding Path=TextColor}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.TextBlockDataTemplate>
        <selectors:SceneObjectTemplateSelector.LineDataTemplate>
            <DataTemplate DataType="{x:Type vm:LineViewModel}">
                <views:LineView
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}"
                    Vertexes="{Binding Path=Vertexes}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.LineDataTemplate>
        <selectors:SceneObjectTemplateSelector.PathDataTemplate>
            <DataTemplate DataType="{x:Type vm:PathViewModel}">
                <views:PathView
                    Width="{Binding Path=Width}"
                    Height="{Binding Path=Height}"
                    FillColor="{Binding Path=FillColor}"
                    Geometry="{Binding Path=Geometry}"
                    IsAntiAliased="{Binding Path=IsAntiAliased}"
                    IsFilled="{Binding Path=IsFilled}"
                    IsSelected="{Binding Path=IsSelected}"
                    IsStroked="{Binding Path=IsStroked}"
                    Location="{Binding Path=Location}"
                    OriginPosition="{Binding Path=OriginPosition}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    Scale="{Binding Path=Scale}"
                    SelectionPadding="{Binding Path=SelectionPadding}"
                    Stretch="{Binding Path=Stretch}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.PathDataTemplate>
        <selectors:SceneObjectTemplateSelector.InputGateDataTemplate>
            <DataTemplate DataType="{x:Type gates:InputGateViewModel}">
                <views:ObjectsGroupView
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}">
                    <views:PortView
                        IsSelected="{Binding Path=OutputPort.IsSelected}"
                        Label="{Binding Path=OutputPort.Name}"
                        Length="{Binding Path=OutputPort.Length}"
                        Location="{Binding Path=OutputPort.Location}"
                        Rotation="{Binding Path=OutputPort.Rotation,
                                           Converter={StaticResource RotationToFloatConverter}}"
                        State="{Binding Path=OutputPort.State}"
                        StrokeColor="{Binding Path=StrokeColor}"
                        StrokeThickness="{Binding Path=StrokeThickness}"
                        StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
                    <views:PathView
                        Width="{Binding Path=Width}"
                        Height="{Binding Path=Height}"
                        FillColor="{Binding Path=FillColor}"
                        Geometry="M 0 0 L 25 0 L 40 15 L 25 30 L 0 30 Z"
                        SelectionPadding="10"
                        Stretch="Uniform"
                        StrokeColor="{Binding Path=StrokeColor}"
                        StrokeThickness="{Binding Path=StrokeThickness}"
                        StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
                </views:ObjectsGroupView>
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.InputGateDataTemplate>
        <selectors:SceneObjectTemplateSelector.OutputGateDataTemplate>
            <DataTemplate DataType="{x:Type gates:OutputGateViewModel}">
                <views:ObjectsGroupView
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}">
                    <views:PortView
                        IsSelected="{Binding Path=InputPort.IsSelected}"
                        Label="{Binding Path=InputPort.Name}"
                        Length="{Binding Path=InputPort.Length}"
                        Location="{Binding Path=InputPort.Location}"
                        Rotation="{Binding Path=InputPort.Rotation,
                                           Converter={StaticResource RotationToFloatConverter}}"
                        State="{Binding Path=InputPort.State}"
                        StrokeColor="{Binding Path=StrokeColor}"
                        StrokeThickness="{Binding Path=StrokeThickness}"
                        StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
                    <views:PathView
                        Width="{Binding Path=Width}"
                        Height="{Binding Path=Height}"
                        FillColor="{Binding Path=FillColor}"
                        Geometry="M 40 30 L 15 30 L 0 15 L 15 0 L 40 0 Z"
                        SelectionPadding="10"
                        Stretch="Uniform"
                        StrokeColor="{Binding Path=StrokeColor}"
                        StrokeThickness="{Binding Path=StrokeThickness}"
                        StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
                </views:ObjectsGroupView>
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.OutputGateDataTemplate>
        <selectors:SceneObjectTemplateSelector.AndGateDataTemplate>
            <DataTemplate DataType="{x:Type gates:AndGateViewModel}">
                <views:ObjectsGroupView
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}">
                    <views:ObjectsGroupView ItemTemplateSelector="{StaticResource PortViewTemplateSelector}" ItemsSource="{Binding Path=InputPorts}" />
                    <views:PortView
                        IsSelected="{Binding Path=OutputPort.IsSelected}"
                        Label="{Binding Path=OutputPort.Name}"
                        Length="{Binding Path=OutputPort.Length}"
                        Location="{Binding Path=OutputPort.Location}"
                        Rotation="{Binding Path=OutputPort.Rotation,
                                           Converter={StaticResource RotationToFloatConverter}}"
                        State="{Binding Path=OutputPort.State}"
                        StrokeColor="{Binding Path=StrokeColor}"
                        StrokeThickness="{Binding Path=StrokeThickness}"
                        StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
                    <views:PathView
                        Width="{Binding Path=Width}"
                        Height="{Binding Path=Height}"
                        FillColor="{Binding Path=FillColor}"
                        Geometry="M 0 0 L 40 0 A 12.5 12.5 90 0 1 40 80 L 0 80 Z"
                        SelectionPadding="10"
                        Stretch="Uniform"
                        StrokeColor="{Binding Path=StrokeColor}"
                        StrokeThickness="{Binding Path=StrokeThickness}"
                        StrokeThicknessType="{Binding Path=StrokeThicknessType}" />
                </views:ObjectsGroupView>
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.AndGateDataTemplate>
        <selectors:SceneObjectTemplateSelector.WireDataTemplate>
            <DataTemplate DataType="{x:Type vm:WireViewModel}">
                <views:LineView
                    IsSelected="{Binding Path=IsSelected}"
                    Location="{Binding Path=Location}"
                    Rotation="{Binding Path=Rotation,
                                       Converter={StaticResource RotationToFloatConverter}}"
                    StrokeColor="{Binding Path=StrokeColor}"
                    StrokeThickness="{Binding Path=StrokeThickness}"
                    StrokeThicknessType="{Binding Path=StrokeThicknessType}"
                    Vertexes="{Binding Path=Vertexes}" />
            </DataTemplate>
        </selectors:SceneObjectTemplateSelector.WireDataTemplate>
    </selectors:SceneObjectTemplateSelector>
</ResourceDictionary>