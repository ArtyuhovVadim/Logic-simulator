<WindowEx
    x:Class="LogicSimulator.Views.Windows.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LogicSimulator.ViewModels.Dialog.Base"
    xmlns:converters="clr-namespace:LogicSimulator.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialog="clr-namespace:LogicSimulator.ViewModels.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Path=Title}"
    Width="450"
    Height="250"
    MinWidth="225"
    MinHeight="125"
    d:DataContext="{d:DesignInstance Type=base:BaseDialogViewModel}"
    Icon="{Binding Path=IconSource,
                   Converter={converters:UriToImageSourceConverter}}"
    ShowInTaskbar="False"
    Style="{StaticResource {x:Type WindowEx}}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <ContentControl Content="{Binding Path=.}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type dialog:InfoDialogViewModel}">
                <Grid Margin="5" GridProps.RowDefinitionsEx="* 5 auto">
                    <TextBox
                        Grid.Row="0"
                        VerticalAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        IsReadOnly="True"
                        Text="{Binding Path=Message}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <Button
                        Grid.Row="2"
                        Padding="20,3"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=OkCommand}"
                        Content="OK"
                        IsCancel="True"
                        IsDefault="True" />
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialog:ErrorDialogViewModel}">
                <Grid Margin="5" GridProps.RowDefinitionsEx="* 5 auto">
                    <TextBox
                        Grid.Row="0"
                        VerticalAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        IsReadOnly="True"
                        Text="{Binding Path=Message}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <Button
                        Grid.Row="2"
                        Padding="20,3"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=OkCommand}"
                        Content="OK"
                        IsCancel="True"
                        IsDefault="True" />
                </Grid>
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</WindowEx>